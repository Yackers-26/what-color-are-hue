# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <username> and <password>.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=huememory

# Gemini key from Google AI Studio. Leave blank until you have one; /api/interpret will say it is not set up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3000
