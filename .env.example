# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <username> and <password>.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=huememory

# Gemini key from Google AI Studio. Leave blank until you have one; /api/interpret will say it is not set up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3000

# Required for sign-in in addition to MONGODB_URI. Set to the browser's actual origin.
APP_ORIGIN=http://localhost:3000

# Google Cloud Console > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Do not expose the client secret in your frontend or push it to GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
